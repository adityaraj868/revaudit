{
  "manifest_version": 3,
  "name": "RevAudit \u2014 GitHub Review Auditor",
  "version": "1.2.0",
  "description": "Audits GitHub review latency with public or signed-in access using the censoring-aware RevAudit API.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://revaudit-backend.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RevAudit Review Auditor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}

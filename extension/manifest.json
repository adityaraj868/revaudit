{
  "manifest_version": 3,
  "name": "RevAudit — GitHub Review Auditor",
  "version": "1.0.0",
  "description": "Audits GitHub pull request review turnaround times, calculates cohort baselines, and flags review latency anomalies.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RevAudit Review Auditor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

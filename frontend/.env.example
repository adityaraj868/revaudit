# Leave empty for local Vite development (defaults to http://localhost:8000).
# Production builds also default to https://revaudit-backend.onrender.com; set a
# value only to target a different API origin.
VITE_API_BASE_URL=

# Supabase Auth Configuration (Phase 1)
# Create a Supabase project at https://supabase.com, enable the GitHub provider
# under Authentication -> Providers, and add the project URL and anon key here.
# The anon key is public and safe for browser builds.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<public-anon-key>

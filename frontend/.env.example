# Leave unset for local Vite development (defaults to http://localhost:8000).
# Set this to the deployed FastAPI origin for a production build.
VITE_API_BASE_URL=https://revaudit-backend.onrender.com

# Supabase Auth Configuration (Phase 1)
# Create a Supabase project at https://supabase.com, enable GitHub Auth provider under Authentication -> Providers,
# and add your project URL and public anon key below:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

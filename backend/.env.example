# Neon Serverless PostgreSQL Connection URL
# Obtain this from your Neon Dashboard: Connection details -> Connection string -> select "Pooled connection" or direct
# Example Neon URL:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://[user]:[password]@[endpoint-id].neon.tech/neondb?sslmode=require

# (Optional) GitHub Personal Access Token to expand rate limits from 60 to 5,000 req/hr
GITHUB_TOKEN=

# GitHub App user-authorization settings. Register the callback URL in GitHub:
# http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# OAuth App default: read:user user:email repo
# GitHub App: leave blank; use the App's fine-grained permissions instead.
GITHUB_OAUTH_SCOPE=read:user user:email repo

# Application/session settings
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Ingestion controls
GITHUB_MAX_PAGES=25
GITHUB_REVIEW_MAX_PRS=250

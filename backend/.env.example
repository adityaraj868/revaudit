# Neon Serverless PostgreSQL Connection URL
# Obtain this from your Neon Dashboard: Connection details -> Connection string -> select "Pooled connection" or direct
# Example Neon URL:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://[user]:[password]@[endpoint-id].neon.tech/neondb?sslmode=require

# (Optional) GitHub Personal Access Token to expand rate limits from 60 to 5,000 req/hr
GITHUB_TOKEN=

# GitHub App user-authorization settings. Register the callback URL in GitHub:
# http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# OAuth App default: read:user user:email repo
# GitHub App: leave blank; use the App's fine-grained permissions instead.
GITHUB_OAUTH_SCOPE=read:user user:email repo

# Application/session settings
# FRONTEND_URL is the full public frontend URL. CORS uses its origin, while
# OAuth error/success redirects keep the path (e.g. GitHub Pages /revaudit/).
# Local:      http://localhost:5173
# Production: https://adityaraj868.github.io/revaudit
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
# Set true for cross-site HTTPS deployments (Render backend + GitHub Pages frontend).
COOKIE_SECURE=false

# Ingestion controls
GITHUB_MAX_PAGES=25
GITHUB_REVIEW_MAX_PRS=250

# Webhook ingestion (Phase 2)
# Register https://<backend-host>/api/webhook/github as a GitHub webhook and use
# the same secret here. The handler verifies X-Hub-Signature-256 and processes
# `pull_request.closed` events in a FastAPI BackgroundTask.
GITHUB_WEBHOOK_SECRET=
# Mirror completed audits into DATABASE_URL so /api/history can serve them.
PERSIST_AUDITS=true
